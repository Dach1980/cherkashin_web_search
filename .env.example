# Необязательные настройки MCP-сервера.
# Файл .env автоматически не загружается; задавайте переменные через env в mcp.json.
# Значения по умолчанию подходят для первого запуска.
# WEB_TIMEOUT_SECONDS=15
# WEB_SEARCH_MAX_RESULTS=5
# WEB_FETCH_MAX_PAGE_CHARS=12000
# WEB_FETCH_MAX_REDIRECTS=3
# WEB_FETCH_MAX_RESPONSE_BYTES=1000000
# WEB_SEARCH_LOG_LEVEL=INFO
